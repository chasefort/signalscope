# ── Required: one AI provider key ─────────────────────────────────────────
# Anthropic (preferred) — triage on Claude Haiku, synthesis on Claude Sonnet.
# Get one at https://console.anthropic.com/  A run costs a few cents.
ANTHROPIC_API_KEY=

# OR OpenAI (fallback, used when no Anthropic key is set) — gpt-5-mini.
# OPENAI_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Tavily web search — adds blogs/reviews/comparison pages to the keyless
# news + community sources. Free tier (1,000 searches/mo): https://tavily.com
# TAVILY_API_KEY=

# Override the models if you want (defaults shown):
# TRIAGE_MODEL=claude-haiku-4-5
# SYNTHESIS_MODEL=claude-sonnet-4-6
